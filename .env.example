# Depuis Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Depuis Google AI Studio (gratuit, sans carte bancaire) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Outils de test sur la page "Ma salle" (+XP, reset progression).
# Actifs par défaut si absent. Mettre à "false" avant un lancement public.
NEXT_PUBLIC_DEBUG_TOOLS=true

# Notifications push (rappel de séance quotidien). Clés déjà générées,
# à copier telles quelles dans Vercel > Settings > Environment Variables.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BP83TvlEJC9N62Te_IGIJA4Azjj_erA3VpIoH8tyibcx-AOKPjdOYyYdPznD-Vs_OtbQrnXzCwb5ypGoA7O3N9g
VAPID_PRIVATE_KEY=jWZ4304NDUxFV7TiBuDoXP17r2VT4H-WjCVeGa-7XYY

# Secret partagé pour que seul Vercel Cron puisse déclencher l'envoi des
# rappels (empêche n'importe qui d'appeler la route publiquement).
# Génère une valeur aléatoire toi-même (ex: un mot de passe long quelconque).
CRON_SECRET=

# Depuis Supabase > Project Settings > API > "service_role" (⚠️ secret,
# ne JAMAIS l'exposer côté client — seule la route de rappel l'utilise,
# côté serveur, pour lire tous les utilisateurs à notifier).
SUPABASE_SERVICE_ROLE_KEY=
